# Copia este archivo a ".env" y completa con tus claves reales.
# ".env" nunca se commitea (ver .gitignore) — este archivo de ejemplo
# sí se commitea, pero solo con valores vacíos/ficticios.

# ── Proveedor de IA ─────────────────────────────────────────────────────
# "openai" o "gemini". Se usa tanto para embeddings como para generación.
AGENT_PROVIDER=openai

# Clave de OpenAI (necesaria si AGENT_PROVIDER=openai).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Clave de Google Gemini (necesaria si AGENT_PROVIDER=gemini).
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── Motor RAG ───────────────────────────────────────────────────────────
DOCUMENTS_DIR=data/documents
INDEX_PATH=data/index/index.json
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=4
# Similitud coseno mínima para considerar un fragmento relevante. Si ningún
# fragmento la supera, el agente responde "no tengo esa información" SIN
# llamar al modelo (primera barrera anti-alucinación).
MIN_SIMILARITY=0.35

# ── Canal WhatsApp Business (Cloud API de Meta) — opcional ──────────────
# Déjalo en "false" hasta tener la cuenta de Meta configurada.
WHATSAPP_ENABLED=false
# Token que tú inventas y que Meta repite al verificar el webhook.
WHATSAPP_VERIFY_TOKEN=
# Token de acceso permanente del System User de Meta.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# "App Secret" de la app de Meta: valida la firma X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# ── Canal Telegram (Bot API) — opcional ─────────────────────────────────
# Para polling local basta con el token; el webhook además necesita ENABLED.
TELEGRAM_ENABLED=false
# Token que entrega @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=
# Secreto que tú inventas (A-Z, a-z, 0-9, _ y -). Telegram lo envía en el
# header X-Telegram-Bot-Api-Secret-Token de cada update del webhook.
TELEGRAM_WEBHOOK_SECRET=
